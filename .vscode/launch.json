{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "RaceOps (Development)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RaceOps.Web/bin/Debug/net10.0/RaceOps.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/RaceOps.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000",
        "DOTNET_ROOT": "/usr/local/share/dotnet"
      },
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "RaceOps (Replay)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/RaceOps.Web/bin/Debug/net10.0/RaceOps.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/RaceOps.Web",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5000",
        "RaceMonitor__ReplayFile": "recordings/race_166564_20260613_112839.rmon"
      },
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}
